ormat of the description.&#x22;,\n    type: '&#x22;plain&#x22; | &#x22;markdown&#x22;',\n    default: '&#x22;markdown&#x22;',\n  },\n  deprecated: {\n    description: &#x22;Shows a deprecation warning when the attribute is used.&#x22;,\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n  },\n  deprecationMessage: {\n    description: &#x22;Custom deprecation text.&#x22;,\n    type: &#x22;string&#x22;,\n    default: '&#x22;&#x22;',\n  },\n  default: {\n    description: &#x22;Default value used during planning when the attribute is not set.&#x22;,\n    type: &#x22;unknown&#x22;,\n    default: &#x22;undefined&#x22;,\n  },\n}\"\n/>"},"298":{"id":"/docs/concepts/schema-14","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#attributeoptions","content":"**Common patterns**"},"299":{"id":"/docs/concepts/schema-15","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#attributeoptions","content":"`optional: true, computed: true` together means \"user can set it, or the provider will compute a default\". This is useful for auto-assigned values like `name` or `region` that the user might want to control."},"300":{"id":"/docs/concepts/schema-16","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"Represents a block that can appear zero or more times (e.g. `network_interface`, `tags`)."},"301":{"id":"/docs/concepts/schema-17","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`NestMode`"},"302":{"id":"/docs/concepts/schema-18","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"Terraform equivalent"},"303":{"id":"/docs/concepts/schema-19","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"TypeScript shape"},"304":{"id":"/docs/concepts/schema-20","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`\"single\"`"},"305":{"id":"/docs/concepts/schema-21","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"At most one block"},"306":{"id":"/docs/concepts/schema-22","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`object \\| null`"},"307":{"id":"/docs/concepts/schema-23","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`\"list\"`"},"308":{"id":"/docs/concepts/schema-24","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"Ordered list of blocks"},"309":{"id":"/docs/concepts/schema-25","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`object[]`"},"310":{"id":"/docs/concepts/schema-26","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`\"set\"`"},"311":{"id":"/docs/concepts/schema-27","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"Unordered set of blocks"},"312":{"id":"/docs/concepts/schema-28","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`object[]`"},"313":{"id":"/docs/concepts/schema-29","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`\"map\"`"},"314":{"id":"/docs/concepts/schema-30","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"Map of blocks keyed by a label"},"315":{"id":"/docs/concepts/schema-31","page_id":"/docs/concepts/schema","tags":[],"type":"text","url":"/docs/concepts/schema#nestedblock","content":"`Record<string, object>`"},"316":{"id":"/docs/concepts/