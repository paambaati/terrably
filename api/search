","content":"Cross-compilation"},"494":{"id":"/docs/distribution/ci-8","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"✗ — one native runner per platform"},"495":{"id":"/docs/distribution/ci-9","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"✓ — single runner, all targets"},"496":{"id":"/docs/distribution/ci-10","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"CI jobs for a full release"},"497":{"id":"/docs/distribution/ci-11","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"5–7 build jobs + 1 release job"},"498":{"id":"/docs/distribution/ci-12","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"1 build job + 1 release job"},"499":{"id":"/docs/distribution/ci-13","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Binary runtime"},"500":{"id":"/docs/distribution/ci-14","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Node.js 25.5+"},"501":{"id":"/docs/distribution/ci-15","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Bun 0.6.0+"},"502":{"id":"/docs/distribution/ci-16","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#github-actions-workflow","content":"Node.js SEA does **not** support cross-compilation — a binary built on macOS will not run on Linux. The solution is a CI matrix that builds natively on each platform, then a single packaging step that assembles all binaries into the release assets the Terraform Registry requires."},"503":{"id":"/docs/distribution/ci-17","page_id":"/docs/distribution/ci","tags":[],"type":"text","ur