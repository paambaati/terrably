n/ci#nodejs-vs-bun","content":"CI jobs for a full release"},"500":{"id":"/docs/distribution/ci-11","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"5–7 build jobs + 1 release job"},"501":{"id":"/docs/distribution/ci-12","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"1 build job + 1 release job"},"502":{"id":"/docs/distribution/ci-13","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Binary runtime"},"503":{"id":"/docs/distribution/ci-14","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Node.js 25.5+"},"504":{"id":"/docs/distribution/ci-15","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#nodejs-vs-bun","content":"Bun 0.6.0+"},"505":{"id":"/docs/distribution/ci-16","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#github-actions-workflow","content":"Node.js SEA does **not** support cross-compilation — a binary built on macOS will not run on Linux. The solution is a CI matrix that builds natively on each platform, then a single packaging step that assembles all binaries into the release assets the Terraform Registry requires."},"506":{"id":"/docs/distribution/ci-17","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#github-actions-workflow","content":"Create `.github/workflows/release.yml` in your provider repository. Replace `mycloud` with your provider's short name."},"507":{"id":"/docs/distribution/ci-18","page_id":"/docs/distribution/ci","tags":[],"type":"text","url":"/docs/distribution/ci#github-actions-workflow","content":"Cross-compilation is not supported with Node.js SEA. Each platform target requires its own native runner in the CI matrix. Use Bun to cross-compile from a single job instead."},"508