90":{"id":"/docs/development/native-addons-7","page_id":"/docs/development/native-addons","type":"heading","tags":[],"url":"/docs/development/native-addons#compression","content":"Compression"},"391":{"id":"/docs/development/native-addons-8","page_id":"/docs/development/native-addons","type":"heading","tags":[],"url":"/docs/development/native-addons#miscellaneous","content":"Miscellaneous"},"392":{"id":"/docs/development/native-addons-9","page_id":"/docs/development/native-addons","type":"heading","tags":[],"url":"/docs/development/native-addons#spawned-native-executables-both-runtimes","content":"Spawned native executables (both runtimes)"},"393":{"id":"/docs/development/native-addons-10","page_id":"/docs/development/native-addons","type":"heading","tags":[],"url":"/docs/development/native-addons#how-to-diagnose-a-transitive-dependency-nodejs","content":"How to diagnose a transitive dependency (Node.js)"},"394":{"id":"/docs/development/native-addons-11","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"When building with **Node.js**, terrably produces a Single Executable Application (SEA) – your provider's JavaScript and all of its dependencies are bundled by esbuild and injected into a Node.js executable at compile time."},"395":{"id":"/docs/development/native-addons-12","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"Native addons (`.node` files) are compiled C/C++ shared libraries. They **cannot** be embedded into a SEA binary because –"},"396":{"id":"/docs/development/native-addons-13","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"They are platform-specific ELF/Mach-O/PE shared objects, not JavaScript."},"397":{"id":"/docs/development/native-addons-14","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"Node.js loads them via `dlopen` at runtime from a filesystem path — a path inside `node_modules`, which does not exist on the end user's machine."},"398":{"id":"/docs/development/native-addons-15","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"esbuild marks all `*.node` imports as external and leaves the original filesystem path in the bundle. The binary builds successfully, but crashes with `MODULE_NOT_FOUND` the first time Terraform invokes it."},"399":{"id":"/docs/development/native-addons-16","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#the-constraint--nodejs-only","content":"terrably catches this **before the compile step** by scanning esbuild's metafile for unresolved non-builtin imports. If any are found, the build fails immediately with a list of the offending packages –"},"400":{"id":"/docs/development/native-addons-17","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#bun--native-addons-work","content":"When building with **Bun**, `bun build --compile` embeds native `.node` addons directly into the output binary. No changes to your dependency tree are needed."},"401":{"id":"/docs/development/native-addons-18","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#bun--native-addons-work","content":"If your provider uses a native addon and portability across platforms matters, keep in mind that the addon must be compiled for each target OS/architecture separately — cross-compilation via `--target` will produce a binary for the right platform, but the *addon* inside it must also have been compiled for that platform. In practice this means building each target binary on a matching native runner (or in a matching Docker image) rather than purely cross-compiling from one machine."},"402":{"id":"/docs/development/native-addons-19","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#pure-js-alternatives-nodejs","content":"If you need to support the Node.js build path, replace native packages with their pure-JS equivalents."},"403":{"id":"/docs/development/native-addons-20","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"Package"},"404":{"id":"/docs/development/native-addons-21","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"What it does"},"405":{"id":"/docs/development/native-addons-22","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"Pure-JS alternative"},"406":{"id":"/docs/development/native-addons-23","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"`argon2`"},"407":{"id":"/docs/development/native-addons-24","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"Argon2 password hashing"},"408":{"id":"/docs/development/native-addons-25","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"`argon2-wasm-pro`, `hash-wasm`"},"409":{"id":"/docs/development/native-addons-26","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"`bcrypt`"},"410":{"id":"/docs/development/native-addons-27","page_id":"/docs/development/native-addons","tags":[],"type":"text","url":"/docs/development/native-addons#cryptography","content":"bcrypt