{
  "name": "terrably",
  "version": "0.0.16",
  "description": "TypeScript-native Terraform provider authoring framework",
  "homepage": "https://paambaati.github.io/terrably/",
  "author": {
    "name": "GP",
    "email": "me@httgp.com",
    "url": "https://httgp.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paambaati/terrably",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/paambaati/terrably/issues",
  "license": "MIT",
  "keywords": [
    "terraform",
    "opentofu",
    "provider",
    "sdk"
  ],
  "files": [
    "dist/",
    "proto/"
  ],
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "proto:gen": "node scripts/gen-proto.js",
    "prepack": "copyfiles ../../README.md ./README.md",
    "postpack": "shx rm ./README.md",
    "prepare": "pnpm run build",
    "build": "pnpm run proto:gen && tsc -p tsconfig.build.json && cp -r src/cli/templates dist/src/cli/",
    "dev": "tsc --watch",
    "lint": "oxlint --type-aware --type-check src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/",
    "test": "node --require tsx/cjs --test 'src/*.test.ts' 'src/cli/commands/*.test.ts'",
    "test:coverage": "node --require tsx/cjs --experimental-test-coverage --test 'src/*.test.ts' 'src/cli/commands/*.test.ts'",
    "prepublishOnly": "pnpm run build && pnpm run lint && pnpm run test"
  },
  "bin": {
    "terrably": "dist/src/cli/index.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@msgpack/msgpack": "3.1.3",
    "adm-zip": "0.5.17",
    "cac": "7.0.0",
    "esbuild": "0.28.0",
    "long": "5.3.2",
    "protobufjs": "7.5.3",
    "nice-grpc": "2.1.16",
    "nice-grpc-common": "2.0.3",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "selfsigned": "5.5.0",
    "ts-proto": "2.11.6"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "25.6.0",
    "@types/nunjucks": "3.2.6",
    "grpc-tools": "1.13.1",
    "native-copyfiles": "2.0.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "oxlint-tsgolint": "0.22.1",
    "shx": "0.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=25.5.0",
    "bun": ">=0.6.0"
  },
  "packageManager": "pnpm@10.33.1"
}
